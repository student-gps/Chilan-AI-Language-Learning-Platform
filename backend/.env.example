# Chilan backend runtime environment template
# Copy to backend/.env for local development, or configure these in Render.

# --- App / CORS ---
# Frontend currently defaults to zh in the browser when no interface language has been chosen yet.
# Auth email fallback defaults to English when no supported language can be resolved.
APP_CORS_ORIGINS=http://localhost:5173,https://www.chilanlearning.com,https://chilanlearning.com

# --- Database ---
# cloud | local
DB_MODE=cloud
APP_DATABASE_URL=
APP_DATABASE_URL_LOCAL=
DB_POOL_ENABLED=true
DB_POOL_MINCONN=1
DB_POOL_MAXCONN=8

# --- Security / JWT ---
SECURITY_JWT_SECRET=
SECURITY_JWT_ALGORITHM=HS256
SECURITY_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- LLM judge (required for study evaluation) ---
# gemini | deepseek
LLM_JUDGE_PROVIDER=gemini

# DeepSeek primary judge (OpenAI-compatible API). Use non-thinking DeepSeek V4 Flash for Tier 3.
LLM_JUDGE_DEEPSEEK_API_KEY=
LLM_JUDGE_DEEPSEEK_MODEL_ID=deepseek-v4-flash
LLM_JUDGE_DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_JUDGE_DEEPSEEK_TIMEOUT_SECONDS=30
LLM_JUDGE_DEEPSEEK_MAX_RETRIES=1
LLM_JUDGE_DEEPSEEK_MAX_TOKENS=512
# Stable, opaque cache-isolation key; never use a learner ID or other PII.
LLM_JUDGE_DEEPSEEK_USER_ID=chilan-tier3
# Optional emergency fallback after retryable DeepSeek API failures: gemini
LLM_JUDGE_FALLBACK_PROVIDER=

# Gemini judge / optional fallback
LLM_JUDGE_GEMINI_USE_VERTEX=false
LLM_JUDGE_GEMINI_MODEL_ID=gemini-2.5-flash
LLM_JUDGE_GEMINI_API_KEY=
LLM_GEMINI_API_KEY=

# Vertex AI alternative for LLM judge
LLM_JUDGE_VERTEX_AI_PROJECT_ID=
VERTEX_AI_PROJECT_ID=
LLM_JUDGE_VERTEX_AI_LOCATION=us-central1
VERTEX_AI_LOCATION=us-central1
LLM_JUDGE_GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# --- Embeddings ---
LLM_EMBED_PROVIDER=doubao
LLM_EMBED_GEMINI_MODEL_ID=gemini-embedding-001
LLM_EMBED_GEMINI_OUTPUT_DIMENSIONALITY=768
LLM_EMBED_GEMINI_API_KEY=
LLM_EMBED_DOUBAO_API_KEY=
LLM_EMBED_DOUBAO_MODEL_ID=
LLM_EMBED_DOUBAO_OUTPUT_DIMENSIONALITY=

# --- Speech / ASR ---
ASR_PROVIDER=openai
ASR_MAX_AUDIO_BYTES=10485760
ASR_OPENAI_MODEL=whisper-1
ASR_OPENAI_API_KEY=
LLM_OPENAI_API_KEY=

# --- Edge TTS ---
TTS_EDGE_VOICE=zh-CN-XiaoxiaoNeural
TTS_EDGE_RATE=-12%
TTS_EDGE_VOICE_EN=en-US-AriaNeural
TTS_EDGE_RATE_EN=+0%
TTS_EDGE_VOICE_JA=ja-JP-NanamiNeural
TTS_EDGE_RATE_JA=-5%

# --- Cloudflare R2 media storage ---
STORAGE_R2_ACCOUNT_ID=
STORAGE_R2_ACCESS_KEY_ID=
STORAGE_R2_SECRET_ACCESS_KEY=
STORAGE_R2_BUCKET=
STORAGE_R2_PUBLIC_BASE_URL=
STORAGE_R2_SIGNED_URL_EXPIRES_SECONDS=3600

# --- Auth / Apple ---
AUTH_APPLE_CLIENT_ID=

# --- Mail delivery ---
# smtp | resend
MAIL_PROVIDER=smtp
MAIL_SMTP_SERVER=
MAIL_SMTP_PORT=587
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_SMTP_FROM=
MAIL_SMTP_USE_SSL=false
MAIL_SMTP_USE_TLS=true
MAIL_RESEND_API_KEY=
MAIL_RESEND_FROM=
MAIL_RESEND_AUDIENCE=
