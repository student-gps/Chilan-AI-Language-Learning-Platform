# Python 虚拟环境和缓存
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
.env
.env.*
!.env.example
!backend/.env.example
backend/credentials/
backend/credentials*.zip
.pytest_cache/
.mypy_cache/

# Node.js 依赖和构建产物
node_modules/
build/
dist/
dist-ssr/

# 编辑器配置
.vscode/
.idea/

# 系统文件
.DS_Store
Thumbs.db

# 巨大的教材文件（建议不要直接传 PDF 到 GitHub）
backend/preparation_codes/test_case_embedding_cache.json
textbook/
documents/
project report/

# content_builder 是本地离线制课工具，生产 API 不依赖该目录。
backend/content_builder/

# Remotion 自动生成文件
frontend/remotion/generated/

# 拼音音频文件（本地生成，不入库）
backend/pinyin_audio/

# 前端按句试听 TTS 缓存（本地生成，不入库）
backend/tts_cache/

# 课程介绍旁白音频（本地生成后上传 R2，不入库）
frontend/public/audio/intro/
frontend/public/audio/japanese-foundations/

# 拼音工具脚本目录（本地工具，不入库）
pinyin_adjustment/

# 海报本地产物与浏览器预览缓存
poster/

# 本地 AI 模型文件
vmodel_v05/

# 本地工具二进制（ffmpeg 等，不入库）
backend/tools/

# Claude Code 本地权限配置（每台机器不同，用 settings.local.json 代替）
.claude/settings.json
.claude/settings.local.json

# BMAD 生成的文档默认不入库；公开项目文档与 README 资源显式放行
docs/*
!docs/*.md
!docs/assets/
!docs/assets/**
